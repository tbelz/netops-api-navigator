# HPE Aruba Networking Central - MCP Server Configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# .env is gitignored and will never be committed.

# Required: Central API credentials
# Find your base URL in Aruba Central under Account Home > API Gateway
CENTRAL_BASE_URL=https://apigw-YOUR_CLUSTER.central.arubanetworks.com
CENTRAL_CLIENT_ID=
CENTRAL_CLIENT_SECRET=

# Optional: GreenLake Platform credentials
# If not set, GreenLake API tools will not be available.
# If set to the same values as Central, you can omit them (Central creds are used as fallback).
# GREENLAKE_CLIENT_ID=
# GREENLAKE_CLIENT_SECRET=
# GLP_BASE_URL=https://global.api.greenlake.hpe.com

# Knowledge database: GitHub repo that publishes knowledge_db.tar.gz releases
KNOWLEDGE_RELEASE_REPO=tbelz/netops-api-navigator
# Optional: pin an immutable workshop snapshot and/or its SHA-256 digest.
# KNOWLEDGE_RELEASE_TAG=knowledge-db-YYYYMMDD-HHMMSS
# KNOWLEDGE_ASSET_SHA256=

# Optional runtime profile: "full" or fail-closed, GET-only "workshop".
# MCP_PROFILE=workshop
